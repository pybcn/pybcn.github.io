#!/usr/bin/env python3
"""Validate the front matter in content/.

Catches the mistakes that a Hugo build does not: a person id that does not
match its filename, a duplicate id, a page that lists a person or sponsor id
with no page behind it, a declared photo with no file behind it, and a
remote photo_url. It warns about a person photo with no colour in it.

For an event photo gallery it catches what the template drops in silence: a
declared photo with no file, a photo with no caption, a photo that points at
a talk of another event, and a talk that credits a person with no page.

For the videos it checks data/channel_videos.yaml, the inventory of the
YouTube channel, against the pages: a video the inventory marks placed has
its link on some event page, every YouTube link of an event front matter
is in the inventory, and a video the inventory leaves out carries a
reason. No network: bin/list-channel is what reads the channel.

For the venues it checks data/venues.yaml, the short name the /events/ list
prints for each venue, against the pages: every venue string of an event
front matter has a row, and every row is the venue of some event. A venue
with no row prints its full string in the list, and a row with no event is
a name the site stopped using.

For the days it checks end_date, which an event carries when it ran more
than one day: it is a date, and it is later than date. The template prints
one day for an end_date it cannot use, so the mistake is silent on the page.

Exit code 1 if any error is found. Warnings do not fail the build.

Usage:
    bin/check-content
"""

import datetime
import pathlib
import re
import struct
import sys
import tomllib

import yaml

# Pillow is the library bin/square-photos needs, and pr.yml installs it for
# this check. A machine without it still runs every other check: the colour
# check reports once that it did not run, so the gap is visible and not an
# error.
try:
    from PIL import Image, ImageChops, ImageStat
except ImportError:
    Image = None

ROOT = pathlib.Path(__file__).resolve().parent.parent
CONTENT = ROOT / "content"
# Person photos moved from static/ to the theme assets so Hugo can process
# them. Accept either location, so the check works before and after that move.
LOGO_DIRS = [
    ROOT / "themes" / "pybcn_theme" / "assets" / "images" / "sponsors",
    ROOT / "assets" / "images" / "sponsors",
]
# Only the asset directories count. The template resolves a photo with
# resources.Get, which does not look in static/, so a file left there renders the
# anonymous avatar instead and the check used to pass.
PHOTO_DIRS = [
    ROOT / "themes" / "pybcn_theme" / "assets" / "images" / "people",
    ROOT / "assets" / "images" / "people",
]

# The photos of an event gallery. partials/photo_gallery.html resolves a
# declared file as images/photos/<file> with resources.Get, which reads the
# theme assets and the project ones, so a file in either place renders. Same
# two roots as PHOTO_DIRS, and static/ counts for neither.
GALLERY_DIRS = [
    ROOT / "themes" / "pybcn_theme" / "assets" / "images" / "photos",
    ROOT / "assets" / "images" / "photos",
]

FRONT_MATTER = re.compile(r"\A---\r?\n(.*?)\r?\n---[ \t]*(?:\r?\n|\Z)", re.S)

errors = []
warnings = []


def error(path, message):
    errors.append(f"{path.relative_to(ROOT)}: {message}")


def warn(path, message):
    warnings.append(f"{path.relative_to(ROOT)}: {message}")


def note(message):
    """A warning about the collection rather than about one file."""
    warnings.append(message)


_front_matter = {}


def front_matter(path):
    """Return the parsed front matter, or None if the file has none.

    The result is kept per path: several checks walk the same files, and a
    file with a YAML error should be reported once.
    """
    if path not in _front_matter:
        _front_matter[path] = _parse_front_matter(path)
    return _front_matter[path]


def _parse_front_matter(path):
    text = path.read_text(encoding="utf-8").lstrip("\ufeff")
    match = FRONT_MATTER.match(text)
    if not match:
        if text.lstrip().startswith("+++"):
            return None  # TOML front matter, not used by content/ today
        error(path, "no YAML front matter")
        return None
    try:
        return yaml.safe_load(match.group(1)) or {}
    except yaml.YAMLError as exc:
        error(path, f"front matter is not valid YAML: {exc}")
        return None


def collect_ids(section):
    """Map id -> path for every page in a section, reporting id problems."""
    found = {}
    for path in sorted((CONTENT / section).glob("*.md")):
        if path.name == "_index.md":
            continue
        data = front_matter(path)
        if data is None:
            continue
        page_id = data.get("id")
        if not page_id:
            error(path, "missing 'id'")
            continue
        if page_id != path.stem:
            error(path, f"id '{page_id}' does not match filename '{path.stem}'")
        if page_id in found:
            error(path, f"duplicate id '{page_id}', already used by {found[page_id].name}")
        found[page_id] = path
    return found


def bare_file_name(path, field, value):
    """True when the value names a file inside its directory and nothing else.

    The templates build the asset path as images/people/<photo> and
    images/sponsors/<logo_image>, and resources.Get resolves a '..' segment.
    So 'logo_image: ../people/x.jpg' showed a person's photo as a sponsor logo,
    and the existence check passed because pathlib resolves '..' the same way.
    A content-only pull request could show any image already in the repository
    on any page. A value with a separator or a '..' segment is an error.
    """
    if "/" in value or "\\" in value or ".." in value:
        error(path, f"{field} '{value}' must be a file name, not a path")
        return False
    return True


def image_size(path):
    """Return (width, height) for a PNG, GIF or JPEG, or None.

    Only the header is read, and only the three formats the people and the
    sponsor directories hold. A format this cannot read returns None and the
    caller skips the check rather than guessing.
    """
    try:
        with open(path, "rb") as handle:
            head = handle.read(32)
            if head[:8] == b"\x89PNG\r\n\x1a\n":
                return struct.unpack(">II", head[16:24])
            if head[:6] in (b"GIF87a", b"GIF89a"):
                return struct.unpack("<HH", head[6:10])
            if head[:2] == b"\xff\xd8":
                handle.seek(2)
                while True:
                    marker = handle.read(2)
                    if len(marker) < 2 or marker[0] != 0xFF:
                        return None
                    if marker[1] in range(0xC0, 0xD0) and marker[1] not in (0xC4, 0xC8, 0xCC):
                        handle.read(3)
                        height, width = struct.unpack(">HH", handle.read(4))
                        return (width, height)
                    length = struct.unpack(">H", handle.read(2))[0]
                    handle.seek(length - 2, 1)
    except (OSError, struct.error):
        return None
    return None


def check_photos(people):
    """Every person photo has to be a square the site can serve as it is.

    The square is cut once, in the repository, by bin/square-photos, so the
    build only resizes. A photo that is not square would be cropped by the
    build instead, by a rule that does not know where the face is, and nobody
    would see the result before it was live.

    The size limits are here for the pull request nobody reads closely: a
    photo straight off a phone is several megabytes and tens of megapixels,
    and it costs the repository that much for ever.
    """
    small = []
    for page_id, path in people.items():
        data = front_matter(path) or {}
        photo = data.get("photo")
        if photo and not bare_file_name(path, "photo", photo):
            continue
        found = next((d / photo for d in PHOTO_DIRS if photo and (d / photo).exists()), None)
        if photo and not found:
            where = ", ".join(str(d.relative_to(ROOT)) for d in PHOTO_DIRS)
            error(path, f"photo '{photo}' not found in any of: {where}")
            continue
        if not found:
            continue

        size = found.stat().st_size
        if size > PHOTO_MAX_BYTES:
            error(path, f"photo '{photo}' is {size // 1024} KB, over the "
                        f"{PHOTO_MAX_BYTES // 1024} KB limit. Run "
                        f"bin/square-photos, or save it smaller.")

        dimensions = image_size(found)
        if not dimensions:
            continue
        width, height = dimensions
        if width != height:
            error(path, f"photo '{photo}' is {width}x{height}, not square. "
                        f"Run bin/square-photos, which crops it on the face.")
        elif width > PHOTO_MAX_SIDE:
            error(path, f"photo '{photo}' is {width}px square, over the "
                        f"{PHOTO_MAX_SIDE}px limit. The site never serves more "
                        f"than 800. Run bin/square-photos.")
        if min(width, height) < PHOTO_SIDE:
            small.append((photo, (width, height)))

        saturation = photo_saturation(found)
        if saturation is not None and saturation < PHOTO_MIN_SATURATION:
            warn(path, f"photo '{photo}' is black and white (colour "
                       f"{saturation:.1f}, under {PHOTO_MIN_SATURATION}). It "
                       f"looks like the others on a screen that greys them on "
                       f"hover, and grey on a phone and in the modal, where "
                       f"the others are in colour. Ask for a colour photo.")
    report_small(small)
    if Image is None and people:
        note("Pillow is not installed, so the black and white photo check did "
             "not run: pip install pillow")


PHOTO_SIDE = 400
PHOTO_MAX_SIDE = 1200
PHOTO_MAX_BYTES = 1_000_000

# Mean of max(r,g,b) - min(r,g,b) per pixel, 0 to 255, over a 64px thumbnail.
# Measured on the 130 photos of October 2026, ten score 0.01 or less and the
# next one 9.5, so any value from 1 to 9 splits the two groups. 4 keeps the
# grey group clear of JPEG chroma noise, which reached 0.01, and leaves the
# muted colour photo nearest the line, at 9.5, more than twice that margin.
PHOTO_MIN_SATURATION = 4


def photo_saturation(path):
    """Return the mean colour of a photo, or None when it cannot be measured.

    The person cards grey every photo with a CSS filter on a device that can
    hover, so a photo that is already black and white looks like the others
    there. On a phone and in the modal nothing greys them, and that photo is
    the one grey face in a wall of colour. Only the person can fix it, with
    another photo, so this is a warning and never an error.

    Two of the ten grey photos are stored as greyscale; the other eight are
    RGB JPEGs with no colour in them, which no header can tell from a colour
    photo. So the pixels are read, through a 64px thumbnail: Pillow decodes a
    JPEG at a fraction of its size for that, and the 130 photos add about
    0.7 s to the run, 0.4 s to 1.1 s.
    """
    if Image is None:
        return None
    try:
        with Image.open(path) as image:
            image.thumbnail((64, 64))
            red, green, blue = image.convert("RGB").split()
    except (OSError, ValueError):
        return None
    high = ImageChops.lighter(ImageChops.lighter(red, green), blue)
    low = ImageChops.darker(ImageChops.darker(red, green), blue)
    return ImageStat.Stat(ImageChops.difference(high, low)).mean[0]


def report_small(small):
    if not small:
        return
    shown = ", ".join(f"{name} ({w}x{h})" for name, (w, h) in sorted(small)[:3])
    note(f"{len(small)} of the person photos are smaller than {PHOTO_SIDE}px on "
         f"their short side, so the build enlarges them and they look soft in "
         f"the grid. Smallest: {shown}. Replacing the file is the only fix.")


def check_gallery(people):
    """Every item of an event photo gallery must reach the page it declares.

    partials/photo_gallery.html skips an item whose file it cannot resolve,
    and an item with no caption, on purpose. A missing asset would otherwise
    stop the build, and an image with no accessible name is worse on the page
    than one photo fewer: bin/check-rendered fails the site for an img with
    no alt, and the caption is that alt. The template drops a talk id it
    cannot find just as quietly, and prints a speaker id that matches no
    person as the id with its hyphens taken out.

    Every one of those is a data mistake that reaches a reader as a page with
    something missing from it, and nothing else reports it. So the silence of
    the template is only safe while this check says the words out loud: the
    file, the item, and what to fix.

    The gallery of one event points only at the talks of its own file, the
    way the template builds its talk index, so a photo that names a talk of
    another edition is an error and not a near miss.
    """
    for path in sorted((CONTENT / "events").rglob("*.md")):
        data = front_matter(path)
        if data is None or not data.get("photos"):
            continue
        photos = data["photos"]
        if not isinstance(photos, dict):
            error(path, f"'photos' holds {photos!r}, which is not a photos "
                        f"block. It takes a date, a thread, and items.")
            continue
        talk_ids = talk_ids_of(path, data, people)

        # Two models of a programme in one file. The migration to talks is
        # closing this, and a file is expected to carry both while it runs,
        # so a warning: what it costs is a reader seeing the same session
        # twice, once from each.
        if data.get("events"):
            warn(path, "declares both 'events' and 'talks'. The page renders "
                       "the schedule from both, so a session can show twice. "
                       "Keep 'talks' and drop 'events' once it is converted.")

        for index, item in enumerate(photos.get("items") or [], start=1):
            if not isinstance(item, dict):
                error(path, f"photo {index} holds {item!r}, which is not a "
                            f"photo. It takes a file and a caption.")
                continue
            check_gallery_item(path, index, item, talk_ids)


_talk_ids = {}


def talk_ids_of(path, data, people):
    """Return the talk ids of one page, reporting a duplicate or a bad speaker.

    A photo finds its talk by id inside its own file, and so does a slot of
    the agenda, so two talks under one id leave the second unreachable: every
    photo of it shows the title of the first, and so does every slot.

    This used to run from check_gallery only, which skips a page with no
    photos block. Two of the ten files that carry a programme have one, so
    the speaker ids of 21 talks were checked and the other 113 were not, and
    those 113 were exactly the ones that needed it: they credited a speaker
    as free text, which an id check cannot see at all. The walk now runs for
    every page that declares talks, from check_agenda, and check_gallery asks
    it for the ids it needs. The result is kept per path so the two callers
    report each mistake once.
    """
    if path in _talk_ids:
        return _talk_ids[path]
    talks = data.get("talks") or []
    if not talks:
        # Not kept: there is nothing to report twice, and a page with no
        # programme would otherwise count towards the coverage figure below.
        return set()
    talk_ids = set()
    unnamed = []
    for position, talk in enumerate(talks, start=1):
        if not isinstance(talk, dict):
            error(path, f"'talks' holds {talk!r} at position {position}, "
                        f"which is not a talk")
            continue
        talk_id = talk.get("id")
        title = talk.get("title") or talk_id or f"position {position}"
        if talk_id in talk_ids:
            error(path, f"talk '{title}' repeats the id '{talk_id}', which an "
                        f"earlier talk of this file already uses. A photo "
                        f"points at a talk by id, so the second talk is "
                        f"unreachable. Give it an id of its own.")
        elif talk_id:
            talk_ids.add(talk_id)

        # speaker, singular, was free text: one string with the names of
        # everyone who gave the talk. No template reads it any more, so a
        # file that still carries one shows no speaker at all on the block
        # and in the modal, and the id check below never sees those names.
        if "speaker" in talk:
            error(path, f"talk '{title}' carries 'speaker' "
                        f"{talk['speaker']!r}, the free-text field that "
                        f"'speakers' replaced. Nothing renders it, so the "
                        f"block and the modal credit nobody. Use speakers, a "
                        f"list of ids of content/people/.")

        speakers = talk.get("speakers") or []
        if not speakers:
            unnamed.append(title)
        for ref in speakers:
            if not isinstance(ref, str):
                error(path, f"talk '{title}' lists {ref!r} as a speaker, "
                            f"which is not an id")
            elif ref not in people:
                error(path, f"talk '{title}' lists unknown speaker id "
                            f"'{ref}'. Add content/people/{ref}.md, or fix "
                            f"the id: the gallery prints an id it cannot "
                            f"find as the id with its hyphens taken out.")
    report_unnamed(path, unnamed, talks)
    _talk_ids[path] = talk_ids
    return talk_ids


def report_unnamed(path, unnamed, talks):
    """A talk with no speaker is correct when the source names nobody.

    It is still worth a figure on every run. The printed agenda of PyDay BCN
    2019 names no speaker at all, and the thread announced only some of the
    sessions, so eleven of its fifteen talks credit nobody and a reader of
    the gallery sees the title alone. A count that grows is the sign that a
    source was read carelessly.
    """
    if not unnamed:
        return
    shown = ", ".join(f"'{title}'" for title in unnamed[:3])
    warn(path, f"no speaker for {len(unnamed)} of the {len(talks)} talks, so "
               f"a photo of one of them shows the title alone: {shown}. "
               f"Correct when the source names nobody.")


def check_gallery_item(path, index, item, talk_ids):
    """Check one photo of a gallery: its file, caption, talk, and source."""
    name = item.get("file")
    label = f"photo {index} '{name}'" if name else f"photo {index}"
    found = gallery_file(path, label, name)
    if found:
        gallery_size(path, label, name, found)

    # The caption is the alt text as well as the visible line, so an item
    # without one is skipped rather than rendered without an accessible name.
    caption = item.get("caption")
    if not str(caption if caption is not None else "").strip():
        error(path, f"{label} has no caption. The caption is the alt text of "
                    f"the image too, so the gallery leaves the photo out "
                    f"rather than publish an image nobody can read. Copy the "
                    f"text of the post.")

    talk_ref = item.get("talk")
    if talk_ref and talk_ref not in talk_ids:
        known = ", ".join(sorted(talk_ids)) or "none"
        error(path, f"{label} points at talk '{talk_ref}', which is not a "
                    f"talk of this file. The gallery credits a photo to a "
                    f"talk of its own event only, so the line is dropped. "
                    f"Use one of: {known}.")

    # The credit line is "Via @account", and the account is the first
    # segment of the path of this URL. So a value that is not a post URL
    # credits the photo to whatever that segment happens to hold.
    source = item.get("source")
    if source is not None and not str(source).strip().startswith("https://"):
        error(path, f"{label} has source '{source}', which is not an https "
                    f"URL. The gallery reads the account that gets the credit "
                    f"out of the path of that URL. Use the address of the "
                    f"post, or remove the line.")


def gallery_file(path, label, name):
    """Return the directory that holds this photo, or None after an error."""
    if not name:
        error(path, f"{label} has no file. Every item names a file under "
                    f"{GALLERY_DIRS[0].relative_to(ROOT)}.")
        return None
    # resources.Get resolves a '..' segment, so a relative path reaches any
    # asset of the repository, and the existence check below would pass. Same
    # hole bare_file_name closes for a person photo, which cannot be reused
    # here: a gallery file is a path, one directory per event.
    if ".." in pathlib.PurePosixPath(str(name)).parts:
        error(path, f"{label} has a '..' segment. A file is named relative to "
                    f"{GALLERY_DIRS[0].relative_to(ROOT)} and stays inside "
                    f"it.")
        return None
    found = next((d for d in GALLERY_DIRS if (d / str(name)).is_file()), None)
    if not found:
        where = ", ".join(str(d.relative_to(ROOT)) for d in GALLERY_DIRS)
        error(path, f"{label} is in none of: {where}. The gallery skips a "
                    f"photo it cannot resolve, so the page shows one photo "
                    f"fewer and says nothing. Add the file, or remove the "
                    f"item.")
    return found


def gallery_size(path, label, name, found):
    """Warn about a photo larger than the widest variant the gallery asks for.

    The cap is the one SOURCE_CAPS already declares for this directory, so
    the two checks cannot drift apart. A warning here and not an error:
    check_sources is what fails the build for a source that is both over the
    cap and heavy, and this names the gallery photo it belongs to.
    """
    cap = source_cap(pathlib.PurePosixPath("photos") / str(name))
    dimensions = image_size(found / str(name))
    if not cap or not dimensions:
        return
    max_width, max_height = cap
    width, height = dimensions
    if width > max_width or (max_height and height > max_height):
        fits = f"{max_width}x{max_height}" if max_height else f"{max_width} wide"
        warn(path, f"{label} is {width}x{height}, over the {fits} the gallery "
                   f"asks of it, so the build carries pixels no reader gets. "
                   f"Run bin/fit-sources.")


# One form per network, so a reader of the files can tell at a glance that two
# links point at the same place, and so nobody has to wonder whether
# es.linkedin.com and www.linkedin.com are the same profile. The hosts are the
# ones each service itself serves: github.com redirects www away, LinkedIn
# serves www, and twitter.com has redirected to x.com since the rename.
SOCIAL_PREFIX = {
    "github": "https://github.com/",
    "linkedin": "https://www.linkedin.com/",
    "twitter": "https://x.com/",
}

# Every field a sponsor template reads. A sponsor renders as its logo, linked
# to its site, and there is no page per sponsor, so anything else in the file
# reaches no reader. Thirty-two files carried a twitter, a linkedin, a
# mastodont or an instagram URL that has never been published: somebody wrote
# them expecting them to show, and nobody could tell they did not.
SPONSOR_FIELDS = {"id", "name", "logo_image", "site", "draft"}


def check_social(people, sponsors):
    """Check the shape of every social link in a person or sponsor file.

    Nothing else checks these. The link checker in CI reads the built pages,
    and a URL broken badly enough is not rendered as a link at all: one
    person's LinkedIn was `ttps://www.linkedin.com/...`, missing the h, which
    a browser treats as a relative path. It had never worked and nobody had
    noticed.

    A trailing slash is an error, not a warning, because the fix is mechanical
    and has one right answer. Left to taste, the values split about two to one
    between the two styles across more than two hundred links. A host has no
    trailing slash (https://ber2.github.io), so a profile path gets none either.

    A sponsor home page is in `site`, the same field as a person's. It was
    `web` until October 2026, and this loop read `site` for both kinds of page,
    so the 66 sponsor URLs were never checked: 29 ended with a slash, one was
    http and one carried a query string. The old name is an error now, so a
    sponsor file copied from an old commit cannot escape the check again.
    """
    for page_id, path in sorted({**people, **sponsors}.items()):
        data = front_matter(path) or {}
        # An empty value is the same as no field to Hugo, so it shows a
        # reader nothing. What it does is look like a checked fact: seven
        # files carried github: "" and nobody had looked for a GitHub
        # account for any of them. Fill it or take it out.
        for field, value in sorted(data.items()):
            if value is None or (isinstance(value, str) and not value.strip()):
                error(path, f"'{field}' is empty. Fill it in, or remove the "
                            f"line: an empty field is the same as no field "
                            f"to Hugo, and it reads as a fact nobody checked.")
        if page_id in sponsors:
            for field in sorted(set(data) - SPONSOR_FIELDS):
                error(path, f"'{field}' is not a sponsor field. A sponsor "
                            f"renders as its logo, linked to its site, and "
                            f"nothing else reaches a reader. Remove it, or "
                            f"render it first.")
        for field, prefix in SOCIAL_PREFIX.items():
            value = data.get(field)
            if not value:
                continue
            value = str(value).strip()
            if "?" in value:
                error(path, f"{field} carries query parameters: '{value}'. "
                            f"Copy the profile URL, not the one the browser "
                            f"was showing.")
            elif not value.startswith(prefix):
                error(path, f"{field} is '{value}', which does not start with "
                            f"{prefix}")
            elif value.endswith("/"):
                error(path, f"{field} ends with a slash: '{value}'. "
                            f"Use '{value.rstrip('/')}'.")

        if "web" in data:
            error(path, "'web' is not a field: put the home page in 'site'")

        if "short_bio" in data:
            # The field held free text about a person, next to the body that
            # held the same kind of text. For 98 of 136 people only one of
            # the two was filled, so the modal showed a "Bio" heading for
            # some people and a "Description" heading for others. In October
            # 2026 every value moved into the body and the template reads
            # only the body now, so a value here is never shown. An error,
            # because the one way the field comes back is a file copied from
            # an old commit, and then the text is lost in silence.
            error(path, "'short_bio' is not a field: put the text in the body "
                        "of the file, under the front matter")

        site = data.get("site")
        if site:
            site = str(site).strip()
            if "?" in site:
                # A warning here, an error on the three profile fields. A
                # profile URL never needs a query, so one is always the
                # tracking the browser added. A site is any address, and the
                # query can be the address: a sponsor links to
                # empleos-barcelona?q=python, and without the query the link
                # lands on every job in Barcelona rather than the Python ones.
                warn(path, f"site carries query parameters: '{site}'. "
                              f"Keep them only if they are part of the "
                              f"address, not tracking the browser added.")
            elif not site.startswith(("https://", "http://")):
                error(path, f"site is '{site}', which is not an http or https URL")
            else:
                if site.endswith("/"):
                    error(path, f"site ends with a slash: '{site}'. "
                                f"Use '{site.rstrip('/')}'.")
                if site.startswith("http://"):
                    # An error, not a warning. A link we publish over http is
                    # one we invite a reader to follow in the clear, and the
                    # site it points at is not ours to make safe. If https
                    # does not answer, that is for its owner to fix, and the
                    # link stays broken rather than insecure.
                    error(path, f"site is served over http, not https: "
                                f"'{site}'. Use https, and if the site does "
                                f"not answer over https, that is for its "
                                f"owner to fix.")


# The largest size the build asks of a source, by directory, and the weight
# that makes an oversized one worth rewriting. Both tables are the ones
# bin/fit-sources works from, and its docstring says which template sets each
# cap. Keep the two in step: this check is what points at that script.
SOURCE_CAPS = {
    "sponsors": (1120, 300),
    "photos": (1600, None),
    "logo.png": (920, None),
}
SOURCE_MIN_KB = 150
SOURCE_MAX_MPX = 4


def source_cap(relative):
    """Return the cap that covers this path under assets/images, or None."""
    for key, cap in SOURCE_CAPS.items():
        if relative.as_posix() == key or relative.parts[0] == key:
            return cap
    return None


def check_sources():
    """A source far larger than anything the site serves is weight and risk.

    Hugo makes every file a reader gets, so a source only has to be as large
    as the biggest variant a template asks for. orpheus.png reached
    23944x5753, which is 138 megapixels and about 551 MB of RAM to decode, for
    a logo the page shows at 560x135. Every build paid that, and so did every
    tool that opened the repository.

    Being over the cap is not enough on its own: a 512x512 logo shown at
    300x300 costs almost nothing, and rewriting it would throw away the only
    copy there is. The file has to be heavy as well, on disk or to decode.
    """
    # The images directory above people/ and sponsors/, which is where the
    # caps are keyed from: both lists name a directory inside it.
    images = {d.parent for d in PHOTO_DIRS + LOGO_DIRS}
    for base in sorted(images):
        if not base.is_dir():
            continue
        for path in sorted(base.rglob("*")):
            if not path.is_file() or path.suffix.lower() not in SOURCE_SUFFIXES:
                continue
            relative = path.relative_to(base)
            cap = source_cap(relative)
            if cap is None:
                continue
            dimensions = image_size(path)
            if not dimensions:
                continue
            width, height = dimensions
            max_width, max_height = cap
            over = width > max_width or (max_height and height > max_height)
            if not over:
                continue
            size = path.stat().st_size
            megapixels = width * height / 1e6
            if size / 1024 <= SOURCE_MIN_KB and megapixels <= SOURCE_MAX_MPX:
                continue
            fits = f"{max_width}x{max_height}" if max_height else f"{max_width} wide"
            error(path, f"is {width}x{height} ({megapixels:.1f} Mpx, "
                        f"{size // 1024} KB), over the {fits} the build asks "
                        f"of it. Run bin/fit-sources.")


SOURCE_SUFFIXES = {".jpg", ".jpeg", ".png", ".webp"}


def check_canonical_photo():
    """Every event names one photo, and the file behind it exists.

    canonical_photo is the one picture of a day: the group photo when the
    day has one, and the picture that says most about it when it does not.
    partials/canonical_photos.html collects them, newest first, and the
    carousel of the home page is one slide per event that has one.

    The template resolves the file with resources.Get and renders nothing
    when it fails, so a typo costs a slide and says nothing.

    An edition with a gallery and no canonical photo is a warning. A
    monthly meetup is not: 64 of them gained a gallery when the posts of
    their own day were imported, and the carousel of the home page shows
    the editions, not every day the association has photographed. A meetup
    that wants a slide names one and gets it.
    """
    missing = []
    for path in sorted((CONTENT / "events").rglob("*.md")):
        data = front_matter(path)
        if data is None:
            continue
        name = data.get("canonical_photo")
        if name:
            gallery_file(path, f"canonical_photo '{name}'", str(name))
        elif data.get("photos") and "meetups" not in path.parts:
            missing.append(path)
    for path in missing:
        warn(path, "has a photo gallery and no 'canonical_photo'. The "
                   "carousel of the home page shows one photo per event, "
                   "and this one has none to show. Name the group photo of "
                   "the day, or the picture that says most about it.")


def check_logos(sponsors):
    """A sponsor whose declared logo file is missing renders a broken image, and
    the Hugo build does not notice. A sponsor with no logo_image at all is only
    a warning, because the template falls back to the name as text.

    The logo field, an external URL, is an error: the template no longer reads
    it, because it accepted any scheme and any host and so let a pull request
    load a third-party image on every page that lists the sponsor."""
    for page_id, path in sponsors.items():
        data = front_matter(path) or {}
        if "logo" in data:
            error(path, f"'logo' is not supported: copy the file under "
                        f"{LOGO_DIRS[0].relative_to(ROOT)} and use logo_image")
        logo = data.get("logo_image")
        if not logo:
            warn(path, f"sponsor '{page_id}' declares no logo, so it renders as text")
            continue
        if not bare_file_name(path, "logo_image", logo):
            continue
        if not any((d / logo).exists() for d in LOGO_DIRS):
            where = ", ".join(str(d.relative_to(ROOT)) for d in LOGO_DIRS)
            error(path, f"logo '{logo}' not found in any of: {where}")


# The front matter keys the templates read to list people or sponsors by id,
# mapped to the name of the id list inside each level. event.html reads
# people_sections and sponsor_levels, people.html reads people_levels and
# sponsors.html reads sponsor_levels.
LISTING_KEYS = {
    "people_sections": "people",
    "people_levels": "people",
    "sponsor_levels": "sponsors",
}


# The keys an entry of a people list may carry when it is a map rather than
# a bare id. people-grid.html reads both; anything else is a misspelling the
# template would drop in silence.
ENTRY_KEYS = {"id", "role"}


def entry_id(path, key, entry):
    """Return the id of one entry of a listing, or None if it has none.

    A people entry is a bare id, or a map with an id and a role that the page
    shows instead of the person's pybcn_position (see people-grid.html). The
    check used to compare the entry itself against the known ids, which
    raised a TypeError on a map.
    """
    if isinstance(entry, str):
        return entry
    if not isinstance(entry, dict):
        error(path, f"'{key}' lists {entry!r}, which is not an id")
        return None
    if key != "people_levels" and key != "people_sections":
        error(path, f"'{key}' lists {entry!r}, but only a people list may hold a map")
        return None
    unknown = set(entry) - ENTRY_KEYS
    if unknown:
        error(path, f"'{key}' entry {entry!r} has unknown key(s) "
                    f"{', '.join(sorted(unknown))}; allowed: id, role")
    if not entry.get("id"):
        error(path, f"'{key}' entry {entry!r} has no id")
        return None
    return entry["id"]


def referenced_ids(path, data, key):
    """Pull every id out of one listing key of a page.

    people_levels and sponsor_levels hold a list of levels. people_sections
    holds a list of sections, each with its own list of levels.
    """
    out = []
    for section in data.get(key) or []:
        if not isinstance(section, dict):
            error(path, f"'{key}' holds {section!r}, which is not a level")
            continue
        for level in section.get("levels") or [section]:
            if not isinstance(level, dict):
                error(path, f"'{key}' holds {level!r}, which is not a level")
                continue
            for entry in level.get(LISTING_KEYS[key]) or []:
                ref = entry_id(path, key, entry)
                if ref is not None:
                    out.append(ref)
    return out


def check_listings(people, sponsors):
    """Every page that lists people or sponsors by id must point at pages that exist.

    The template drops an unknown id without a word, so the page just shows one
    sponsor or one person less. The check walks every file under content/ and
    looks for the keys the templates read, instead of a fixed set of
    directories or page names. The old events walk covered content/events/
    only, so a typo in content/sponsors/_index.md or in
    content/pyladies_bcn/sponsors.md was never reported, and the organizers
    pages were listed by name, so a rename switched that check off in silence.

    Returns the set of person ids that some page lists, for the orphan check.
    The speakers of the talks count: a talk credits a person by id, the page
    prints the name of that person record on the block and in the detail
    modal, and partials/appearances_index.html gives the person that event as
    an appearance. The ids themselves are checked in check_talk_ids, which
    reports an unknown one with the title of its talk, so this walk only
    collects the ones that resolve.
    """
    listed_people = set()
    for path in sorted(CONTENT.rglob("*.md")):
        data = front_matter(path)
        if data is None:
            continue
        for key, kind in LISTING_KEYS.items():
            if key not in data:
                continue
            known = people if kind == "people" else sponsors
            noun = "person" if kind == "people" else "sponsor"
            for ref in referenced_ids(path, data, key):
                if ref not in known:
                    error(path, f"'{key}' references unknown {noun} id '{ref}'")
                elif kind == "people":
                    listed_people.add(ref)
        for talk in data.get("talks") or []:
            if not isinstance(talk, dict):
                continue
            for ref in talk.get("speakers") or []:
                if isinstance(ref, str) and ref in people:
                    listed_people.add(ref)
    return listed_people


# The types partials/event_types.html knows. A slot that holds no talk names
# its own type, and an unknown one renders no icon and only warns at build
# time, which nobody reads.
ENTRY_TYPES = {"workshop", "talk", "lightning", "keynote", "panel", "group",
               "coffee", "lunch", "photo", "qa"}

# The closed vocabulary of the language field. It used to be free text and
# carried seven spellings of these three languages.
#
# A list, for a session given in two languages, is written in this order. The
# archive held "en, es" once and "es, en" three times for the same pair, and
# the page printed "English / Spanish" and "Spanish / English" for it, because
# partials/agenda_entry.html prints the codes in the order the list gives
# them. The order below is the one AGENTS.md and the label table of that
# partial already declare, so there is one order and not two.
LANGUAGE_ORDER = ("en", "es", "ca")
LANGUAGES = set(LANGUAGE_ORDER)


def check_agenda(people):
    """Check the schedule of an event page: its rooms, its talks, its grid.

    The page carries the grid (agenda) apart from the content (talks),
    joined by a talk id, and that join fails in silence: a slot that names a
    talk the page does not define renders as an empty block, which looks
    like a gap in the programme and not like a mistake.

    The colour of a block is no longer checked here, because it is no longer
    in the content. partials/agenda_entry.html gives every room of an event
    one colour of the palette agenda.scss defines. The old check demanded a
    colour on every entry, which is how the archive ended up with 157 of
    them that meant nothing.
    """
    for path in sorted(CONTENT.rglob("*.md")):
        data = front_matter(path)
        if data is None:
            continue
        if data.get("events"):
            error(path, "carries 'events', the schedule model that 'agenda' "
                        "and 'talks' replaced. The template no longer reads "
                        "it, so the whole schedule of this page is missing "
                        "from the built site.")
        rooms = check_rooms(path, data)
        talks = check_talks(path, data, people)
        for position, slot in enumerate(data.get("agenda") or [], start=1):
            check_slot(path, position, slot, rooms, talks)
        check_session_videos(path, data)


def check_rooms(path, data):
    """Return the room ids of one page, reporting a missing or repeated id."""
    found = set()
    for position, room in enumerate(data.get("rooms") or [], start=1):
        if not isinstance(room, dict):
            error(path, f"'rooms' holds {room!r} at position {position}, "
                        f"which is not a room")
            continue
        room_id = room.get("id")
        if not room_id:
            error(path, f"room {position} has no id. A slot of the agenda "
                        f"names its room by id, and the colour of the block "
                        f"comes from it.")
        elif room_id in found:
            error(path, f"room {position} repeats the id '{room_id}'. Two "
                        f"records under one id leave the second unreachable.")
        else:
            found.add(room_id)
        if not str(room.get("name") or "").strip():
            error(path, f"room '{room_id}' has no name. The name is what the "
                        f"block of the grid prints.")
    return found


def check_talks(path, data, people):
    """Return the talk ids of one page, checking the fields the grid reads."""
    found = talk_ids_of(path, data, people)
    for position, talk in enumerate(data.get("talks") or [], start=1):
        if not isinstance(talk, dict):
            continue  # talk_ids_of already reports this one
        talk_id = talk.get("id")
        title = talk.get("title") or talk_id or f"position {position}"
        language = talk.get("language")
        codes = [language] if isinstance(language, str) else language or []
        for code in codes:
            if code not in LANGUAGES:
                error(path, f"talk '{title}' has language '{code}'. Use "
                            f"{', '.join(LANGUAGE_ORDER)}, or a list of "
                            f"them for a session given in two.")
        known = [code for code in codes if code in LANGUAGES]
        if len(known) > 1:
            expected = [code for code in LANGUAGE_ORDER if code in known]
            if known != expected:
                error(path, f"talk '{title}' lists its languages as "
                            f"{known}. A list is written in the order "
                            f"{list(LANGUAGE_ORDER)}, because the page prints "
                            f"the codes in the order the list gives them: two "
                            f"orders print the same pair two ways. Use "
                            f"{expected}.")
        if talk.get("type") not in ENTRY_TYPES:
            error(path, f"talk '{title}' has type '{talk.get('type')}', which "
                        f"is not one of: {', '.join(sorted(ENTRY_TYPES))}")
        # Optional: the printed programme of PyDay BCN 2018 gives no length
        # at all, so none of its talks stores one. A value that is there has
        # to be a number, because the end of the slot is computed from it.
        if "duration_minutes" in talk and not isinstance(talk["duration_minutes"], int):
            error(path, f"talk '{title}' has duration_minutes "
                        f"{talk['duration_minutes']!r}, which is not a whole "
                        f"number of minutes. The end of the slot is computed "
                        f"from it.")
        check_links(path, f"talk '{title}'", talk.get("links"))
    return found


def check_links(path, label, links):
    for position, link in enumerate(links or [], start=1):
        if not isinstance(link, dict):
            error(path, f"{label} holds {link!r} as link {position}, which "
                        f"is not a link")
            continue
        if not str(link.get("url") or "").startswith("http"):
            error(path, f"{label} has link {position} with url "
                        f"{link.get('url')!r}, which is not an address")
        if not link.get("type"):
            error(path, f"{label} has link {position} with no type. Only a "
                        f"video gets its own line on the block; everything "
                        f"else is listed under Repository.")


def check_session_videos(path, data):
    """Check the event-level session_videos block, and that no video of the
    page is listed twice.

    A recording of a whole session, a block of lightning talks or the
    introduction of an evening, belongs to no talk, so bin/import-videos
    writes it as an entry of session_videos: a title and a url.
    partials/session_videos.html prints those under a Recordings heading,
    and it does what the gallery does with a photo it cannot place: an entry
    with no url is skipped in silence, and an entry with no title prints a
    Watch link with no title in it. The same URL on a talk link and in the
    block, or twice in the block, renders two identical entries, which the
    template cannot tell apart from two recordings. Nothing but this check
    says any of that out loud.

    The key is session_videos and not videos, because Hugo reads
    .Params.videos as the og:video URLs of the page and fails the build on a
    list of records there. An entry under that key is reported for the same
    reason: the build would say so too, but with a stack of template frames
    and no file name a person can act on.
    """
    if "videos" in data:
        error(path, "carries 'videos', which Hugo reserves for the og:video "
                    "URLs of a page: a list of records under it stops the "
                    "build. The recording of a whole session goes in "
                    "'session_videos'.")
    seen = {}
    for talk in data.get("talks") or []:
        if isinstance(talk, dict):
            label = f"talk '{talk.get('title') or talk.get('id')}'"
            for url in video_urls_of(talk):
                seen.setdefault(url, label)
    for position, slot in enumerate(data.get("agenda") or [], start=1):
        if isinstance(slot, dict) and not slot.get("talk"):
            for url in video_urls_of(slot):
                seen.setdefault(url, f"agenda slot {position}")

    entries = data.get("session_videos")
    if entries is None:
        return
    if not isinstance(entries, list):
        error(path, f"'session_videos' holds {entries!r}, which is not a list "
                    f"of videos. Each entry takes a title and a url.")
        return
    for index, entry in enumerate(entries, start=1):
        label = f"session video {index}"
        if not isinstance(entry, dict):
            error(path, f"{label} holds {entry!r}, which is not a video. It "
                        f"takes a title and a url.")
            continue
        if not str(entry.get("title") or "").strip():
            error(path, f"{label} has no title. The title is the only line "
                        f"the gallery prints over the Watch link, so the entry "
                        f"would read as a link with no name. Use the title the "
                        f"channel gives the recording.")
        url = str(entry.get("url") or "").strip()
        if not url:
            error(path, f"{label} has no url. The gallery skips an entry it "
                        f"cannot link, so the page shows one video fewer and "
                        f"says nothing. Add the address, or remove the entry.")
            continue
        if not url.startswith("https://"):
            error(path, f"{label} has url '{url}', which is not an https "
                        f"address. bin/check-rendered fails a built page that "
                        f"carries an http:// URL.")
        if url in seen:
            error(path, f"{label} repeats {url}, already on {seen[url]} of "
                        f"this page. The gallery would list the same video "
                        f"twice. Keep one of the two.")
        else:
            seen[url] = label


def video_urls_of(record):
    """Return the video URLs of one talk or one row of the grid, the links
    of type video, as partials/agenda_entry.html and
    layouts/_default/meetup.html read them."""
    return [str(link.get("url")) for link in record.get("links") or []
            if isinstance(link, dict) and link.get("type") == "video" and link.get("url")]


# The inventory of the YouTube channel: one entry per video of the channel
# with the decision the site took on it, placed or not and why, plus the
# videos of other channels the event pages link. It is the list the site
# maintains. bin/list-channel refreshes it from the channel over the
# network; this check reads the file and the pages and never the network.
INVENTORY = ROOT / "data" / "channel_videos.yaml"

# The id of a YouTube video inside any of the URL shapes YouTube hands out.
# The pages write watch?v= today, and a hand-written link may arrive in any
# of the others.
YOUTUBE_ID = re.compile(
    r"https?://(?:www\.|m\.)?(?:youtube\.com/(?:watch\?(?:[^#\s]*&)?v=|embed/|shorts/|live/|v/)"
    r"|youtu\.be/)([A-Za-z0-9_-]{11})")
VIDEO_ID = re.compile(r"\A[A-Za-z0-9_-]{11}\Z")

# What check_channel_videos counted, for the summary line.
_inventory_summary = None

# The short name of each venue, keyed by the exact string the venue field of
# an event carries. layouts/_default/events_index.html prints the short name
# in the /events/ list and falls back to the full string for a venue with no
# row, which is the gap check_venues reports.
VENUES = ROOT / "data" / "venues.yaml"

# What check_venues counted, for the summary line.
_venue_summary = None


def page_video_links():
    """Return {video id: [(path, where)]} for every YouTube link in the front
    matter of content/events/.

    The three places a page carries one: the links of a talk, the links of
    a row of the grid that holds no talk (the welcome of PyDay BCN 2020),
    and the session_videos block. Every link counts, whatever its type: a
    YouTube address under slides is still a video this site points at.
    """
    found = {}
    for path in sorted((CONTENT / "events").rglob("*.md")):
        data = front_matter(path)
        if data is None:
            continue
        links = []
        for talk in data.get("talks") or []:
            if isinstance(talk, dict):
                label = f"talk '{talk.get('id') or talk.get('title')}'"
                links += [(label, link) for link in talk.get("links") or []]
        for position, slot in enumerate(data.get("agenda") or [], start=1):
            if isinstance(slot, dict) and not slot.get("talk"):
                links += [(f"agenda slot {position}", link)
                          for link in slot.get("links") or []]
        for index, entry in enumerate(data.get("session_videos") or [], start=1):
            links.append((f"session video {index}", entry))
        for where, link in links:
            if not isinstance(link, dict):
                continue
            match = YOUTUBE_ID.search(str(link.get("url") or ""))
            if match:
                found.setdefault(match.group(1), []).append((path, where))
    return found


def check_channel_videos():
    """Check data/channel_videos.yaml against the video links of the pages.

    Three rules, which together turn "a video is missing from a page" from
    a thing a reader notices into an error here:

      1. an entry marked placed has its link on some event page. A video
         the channel holds and no page shows is the gap this inventory
         exists to close.
      2. every YouTube link of an event front matter is in the inventory,
         under videos when the channel holds it and under elsewhere when
         another channel does. A link to a video the inventory does not
         know is a link nobody decided on.
      3. an entry marked placed: false carries a reason. "Not placed" with
         no reason is a video somebody forgot, which looks the same as a
         video somebody left out on purpose.

    Also reported, because the rules above mean nothing without them: an
    id that is not an 11-character YouTube id, an id listed twice, an entry
    with no title, an unplaced entry that a page does link, and a video of
    another channel with no channel named.
    """
    global _inventory_summary
    if not INVENTORY.is_file():
        error(INVENTORY, "is missing. It is the inventory of the YouTube "
                         "channel, one entry per video with the decision the "
                         "site took on it. bin/list-channel says how to "
                         "rebuild it from the channel.")
        return
    try:
        data = yaml.safe_load(INVENTORY.read_text(encoding="utf-8"))
    except yaml.YAMLError as exc:
        error(INVENTORY, f"is not valid YAML: {exc}")
        return
    if not isinstance(data, dict):
        error(INVENTORY, "does not hold a mapping with 'videos' and 'elsewhere'")
        return

    linked = page_video_links()
    known = {}
    placed = unplaced = elsewhere = 0
    for section in ("videos", "elsewhere"):
        entries = data.get(section)
        if entries is None:
            error(INVENTORY, f"has no '{section}' list")
            continue
        if not isinstance(entries, list):
            error(INVENTORY, f"'{section}' holds {entries!r}, which is not a list")
            continue
        for index, entry in enumerate(entries, start=1):
            label = f"{section} entry {index}"
            if not isinstance(entry, dict):
                error(INVENTORY, f"{label} holds {entry!r}, which is not a video. "
                                 f"It takes an id, a title, and the decision.")
                continue
            video_id = str(entry.get("id") or "")
            if not VIDEO_ID.match(video_id):
                error(INVENTORY, f"{label} has id {video_id!r}, which is not an "
                                 f"11-character YouTube video id")
                continue
            label = f"{section} entry {video_id}"
            if video_id in known:
                error(INVENTORY, f"{label} is listed twice, already as {known[video_id]}")
                continue
            known[video_id] = label
            if not str(entry.get("title") or "").strip():
                error(INVENTORY, f"{label} has no title. Use the title the channel "
                                 f"shows, so a person can tell the videos apart.")
            if section == "elsewhere":
                elsewhere += 1
                if not str(entry.get("channel") or "").strip():
                    error(INVENTORY, f"{label} names no channel. An entry under "
                                     f"elsewhere says which channel hosts the video.")
                continue
            decision = entry.get("placed")
            if not isinstance(decision, bool):
                error(INVENTORY, f"{label} has placed: {decision!r}. It is true when "
                                 f"an event page carries the link and false, with "
                                 f"a reason, when the video belongs to no page.")
                continue
            if decision:
                placed += 1
                if video_id not in linked:
                    error(INVENTORY, f"{label} is marked placed, and no event page "
                                     f"carries https://www.youtube.com/watch?v="
                                     f"{video_id}. Write the link on the talk of "
                                     f"its event (a link of type video), or in "
                                     f"session_videos for the recording of a whole "
                                     f"session, or mark it placed: false with a "
                                     f"reason.")
                continue
            unplaced += 1
            for path, where in linked.get(video_id, []):
                error(INVENTORY, f"{label} is marked placed: false, and "
                                 f"{path.relative_to(ROOT)} carries it on {where}. "
                                 f"Set placed: true, or remove the link.")
            if not str(entry.get("reason") or "").strip():
                error(INVENTORY, f"{label} is marked placed: false with no reason. "
                                 f"Say why the video belongs to no page, so a "
                                 f"video left out on purpose does not look like "
                                 f"one somebody forgot.")

    for video_id, places in sorted(linked.items()):
        if video_id in known:
            continue
        for path, where in places:
            error(path, f"{where} links the YouTube video {video_id}, which "
                        f"data/channel_videos.yaml does not list. A video of the "
                        f"channel goes under videos with placed: true; a video "
                        f"another channel hosts goes under elsewhere with its "
                        f"channel.")

    links = sum(len(places) for places in linked.values())
    _inventory_summary = (f"{placed + unplaced} channel videos in the inventory, "
                          f"{placed} placed, {unplaced} unplaced with a reason, "
                          f"{elsewhere} videos of other channels; "
                          f"{links} YouTube links to {len(linked)} videos on the pages.")


def page_venues():
    """Return {venue string: [path]} for every venue of content/events/.

    The venue field holds the name the way its source wrote it, one string
    per page, and the string is the key: two spellings of one place are two
    entries here and two rows of data/venues.yaml. A venue that is not a
    string is reported and skipped, because the template would print it
    as text and the table could never hold a row for it.
    """
    found = {}
    for path in sorted((CONTENT / "events").rglob("*.md")):
        data = front_matter(path)
        if data is None or "venue" not in data:
            continue
        venue = data["venue"]
        if not isinstance(venue, str) or not venue.strip():
            error(path, f"venue holds {venue!r}, which is not a name. It is the "
                        f"place as its source wrote it, one string.")
            continue
        found.setdefault(venue, []).append(path)
    return found


def check_venues():
    """Check data/venues.yaml against the venue field of the event pages.

    Two rules, one per direction, so the table cannot rot either way:

      1. every venue string of an event front matter has a row. The list
         prints the full string for a venue with no row, so a long name
         comes back in silence the day an event arrives with a venue the
         table does not know.
      2. every row is the venue of at least one event. A row no page uses
         is a name the site stopped using, or a string somebody edited in
         the event and not here, and either way it is a row nobody checks.

    Also reported: a row whose short name is empty or not a string, since
    the list would print nothing for that venue.

    Report, never crash: a missing or malformed table is an error with the
    reason, and the rest of the check still runs.
    """
    global _venue_summary
    venues = page_venues()
    if not VENUES.is_file():
        error(VENUES, "is missing. It is the short name of each venue, which "
                      "the /events/ list prints, one row per venue string of "
                      "the event pages.")
        return
    try:
        table = yaml.safe_load(VENUES.read_text(encoding="utf-8"))
    except yaml.YAMLError as exc:
        error(VENUES, f"is not valid YAML: {exc}")
        return
    if not isinstance(table, dict):
        error(VENUES, f"holds {type(table).__name__}, not a mapping of the "
                      f"venue string to its short name")
        return

    for long_name, short_name in table.items():
        label = f"row {long_name!r}"
        if not isinstance(long_name, str):
            error(VENUES, f"{label} has a key that is not a string. The key is "
                          f"the venue string exactly as the event carries it.")
            continue
        if not isinstance(short_name, str) or not short_name.strip():
            error(VENUES, f"{label} has the short name {short_name!r}. It is the "
                          f"name the list prints, so it is a non-empty string.")
        if long_name not in venues:
            error(VENUES, f"{label} is the venue of no event page. Remove the "
                          f"row, or fix the venue of the event that renamed it.")

    for long_name, paths in sorted(venues.items()):
        if long_name in table:
            continue
        for path in paths:
            error(path, f"venue {long_name!r} has no row in data/venues.yaml. "
                        f"Add the row with the short name the /events/ list "
                        f"prints; without it the list prints the full string.")

    pages = sum(len(paths) for paths in venues.values())
    shortened = sum(1 for k, v in table.items()
                    if isinstance(k, str) and isinstance(v, str) and k != v)
    _venue_summary = (f"{len(table)} venues in data/venues.yaml, {shortened} "
                      f"shortened, {len(set(table.values()))} short names; "
                      f"{len(venues)} distinct venue strings on {pages} pages.")


def as_date(value):
    """The date a front matter value holds, or None when it holds none.

    An unquoted 2016-09-17 arrives as a date from the YAML parser, a quoted
    one as a string, and a value with a time as a datetime. Hugo reads all
    three the same way, so all three count.
    """
    if isinstance(value, datetime.datetime):
        return value.date()
    if isinstance(value, datetime.date):
        return value
    if isinstance(value, str):
        try:
            return datetime.date.fromisoformat(value.strip())
        except ValueError:
            return None
    return None


def check_dates():
    """An event that ran more than one day carries end_date, its last day.

    date is the first day and end_date the last, both YAML dates, and
    partials/event_date.html prints the two as one range. The partial
    treats an end_date that is not after date as absent, so a mistake in
    the key turns a two day edition back into one day in silence: the page
    builds and reads right. This says it: when end_date is there, it is a
    date, date is there too, and end_date is strictly later than date. A
    one day event has no end_date at all.

    Report, never crash: a value that is not a date is an error with the
    value in it, and the rest of the check runs.
    """
    for path in sorted((CONTENT / "events").rglob("*.md")):
        data = front_matter(path)
        if data is None or "end_date" not in data:
            continue
        raw_end = data["end_date"]
        end = as_date(raw_end)
        if end is None:
            error(path, f"end_date is {raw_end!r}, which is not a date. Write "
                        f"the last day of the event as YYYY-MM-DD, or remove "
                        f"the key for an event of one day.")
            continue
        raw_start = data.get("date")
        start = as_date(raw_start)
        if start is None:
            error(path, f"end_date {end} needs a date to be the end of, and "
                        f"date is {raw_start!r}. Write the first day as "
                        f"YYYY-MM-DD.")
            continue
        if end == start:
            error(path, f"end_date {end} is the same day as date. An event of "
                        f"one day carries no end_date: remove the key.")
        elif end < start:
            error(path, f"end_date {end} is before date {start}. end_date is "
                        f"the last day of the event, so it is later than "
                        f"date.")


def check_slot(path, position, slot, rooms, talks):
    """Check one row of the grid: where it sits, and what fills it."""
    if not isinstance(slot, dict):
        error(path, f"'agenda' holds {slot!r} at position {position}, which "
                    f"is not a slot")
        return
    where = f"agenda slot {position}"
    start = slot.get("start")
    # An unquoted 9:00 is the integer 540 in YAML 1.1, sexagesimal. Hugo's
    # parser reads it as a string and the page looks right, so nothing but
    # this says the value is not what the file appears to hold.
    if not isinstance(start, str) or not re.fullmatch(r"\d{1,2}:\d{2}", start):
        error(path, f"{where} has start {start!r}. A start is a quoted H:MM "
                    f"string: YAML 1.1 reads an unquoted 9:00 as the integer "
                    f"540.")
    else:
        where = f"agenda slot {position} ({start})"
    if not isinstance(slot.get("track_length"), int):
        error(path, f"{where} has track_length "
                    f"{slot.get('track_length')!r}, which is not a number of "
                    f"tracks. The block spans that many columns.")
    room = slot.get("room")
    if room is not None and room not in rooms:
        known = ", ".join(sorted(rooms)) or "none"
        error(path, f"{where} names room '{room}', which this page does not "
                    f"declare. Use one of: {known}.")
    talk = slot.get("talk")
    if talk is not None and talk not in talks:
        known = ", ".join(sorted(talks)) or "none"
        error(path, f"{where} names talk '{talk}', which this page does not "
                    f"declare. The block renders empty, which reads as a gap "
                    f"in the programme. Use one of: {known}.")
    if slot.get("speaker") is not None:
        error(path, f"{where} carries 'speaker' {slot['speaker']!r}, the "
                    f"free-text field that 'speakers' replaced. Nothing "
                    f"renders it. Use speakers, a list of ids of "
                    f"content/people/, or leave the slot with none: the "
                    f"organising committee of an edition is not a person.")
    if talk is None:
        if slot.get("type") not in ENTRY_TYPES:
            error(path, f"{where} holds no talk and has type "
                        f"{slot.get('type')!r}. A slot with no talk is a row "
                        f"of the day and names its own type, one of: "
                        f"{', '.join(sorted(ENTRY_TYPES))}")
        if not isinstance(slot.get("duration_minutes"), int):
            error(path, f"{where} holds no talk and has duration_minutes "
                        f"{slot.get('duration_minutes')!r}. With no talk to "
                        f"read it from, the slot carries its own length.")
        check_links(path, where, slot.get("links"))


# What a row of /people/ can show about a person, apart from the name: the
# photo, the social links, the position, and the body of the file. A record
# with none of the four, and with no page crediting it either, is a row of a
# bare name. See themes/pybcn_theme/layouts/people/list.html.
PERSON_CONTENT_FIELDS = ("photo", "github", "linkedin", "twitter", "site",
                         "pybcn_position")


def body(path):
    """The text under the front matter, which is the bio of a person file."""
    text = path.read_text(encoding="utf-8").lstrip("﻿")
    match = FRONT_MATTER.match(text)
    return (text[match.end():] if match else text).strip()


def check_orphans(people, listed_people):
    """A person record the site publishes and can say nothing about.

    This used to report a person no listing points at, because the page of
    that person rendered and nothing linked to it. That is no longer the
    state: /people/ lists every file of the section, so every record has an
    inbound link and a row by being in the folder, and the row links to the
    page of the person, /people/<id>/, which came back with the Archive
    (config.toml has the history). Being unlisted no longer hides a record;
    it only empties its row and its page.

    So the error this looks for now is a row with nothing in it: no page
    credits the record, and the file carries no photo, no social link, no
    position, and no bio. The name is then the whole row, which is a
    published claim that this person was part of the association with
    nothing behind it. Either the programme that names them is missing, and
    crediting the talk fixes the row, or the file is a leftover and goes.

    The uncredited records are reported together as one note, not one
    warning each. They are not a defect of the file: most of them hold a
    photo, a bio, or both, and what is missing is the page that says where
    they served. One line names them all, so a reader sees the shape of the
    gap instead of a line per record that each says a part of it.

    listed_people is the set check_listings collected from the front matter
    keys and from the speakers of the talks, so only a real listing counts.
    A page that carries a programme and no people_sections, PyData Barcelona
    2017, PyDay BCN 2018, or PyDay BCN 2019, reaches its speakers through
    the talks alone. An earlier version searched the text of every page with
    a word-boundary regex, and a regex boundary sits between a letter and a
    hyphen: 'ricardo' matched inside 'ricardo-ander-egg' and 'jordi' inside
    'jordi-bosch', so those two pages passed with no listing at all. Prose
    that happens to contain an id does not count as a reference either.
    """
    uncredited = []
    for page_id, path in sorted(people.items()):
        if page_id in listed_people:
            continue
        uncredited.append(page_id)
        data = front_matter(path) or {}
        if any(data.get(field) for field in PERSON_CONTENT_FIELDS):
            continue
        if body(path):
            continue
        warn(path, f"person '{page_id}' holds a name and nothing else, and no "
                   f"event or page credits it, so its row on /people/ is the "
                   f"name alone. Credit the talk or the page the person "
                   f"belongs to, or delete the file.")
    if uncredited:
        note(f"{len(uncredited)} person records are credited by no event and "
             f"no page, so their row on /people/ and their own page carry no "
             f"role, no year and no event: {', '.join(uncredited)}. A record is credited by the "
             f"people block of a page, or by the speakers of a talk.")


SECURITY_TXT = ROOT / "static" / ".well-known" / "security.txt"
SECURITY_TXT_NOTICE_DAYS = 30


CONFIG = ROOT / "config.toml"

# The keys of [params.association] that only the Management Board can fill,
# and what each one is for. See the comment in config.toml.
ASSOCIATION_KEYS = {
    "address": "the registered address, which LSSI-CE article 10 requires the "
               "legal notice to publish",
    "registry": "the entry in the Registre d'Associacions de la Generalitat "
                "de Catalunya, which LSSI-CE article 10 requires too",
}


def check_association():
    """The legal notice reads who the association is from config.toml.

    Two of those facts are not a volunteer's to write: the registered address
    and the entry in the register of associations. Should either be emptied,
    this says so on every run rather than letting the legal notice go out
    with a gap in the one section the law asks for.

    A warning and not an error: the site builds and serves fine without them,
    and an error would turn every pull request red for a reason no
    contributor can fix. The page that needs them is the gate.
    """
    try:
        with open(CONFIG, "rb") as handle:
            config = tomllib.load(handle)
    except (OSError, tomllib.TOMLDecodeError) as problem:
        error(CONFIG, f"cannot be read: {problem}")
        return
    association = (config.get("params") or {}).get("association") or {}
    for key, what in sorted(ASSOCIATION_KEYS.items()):
        if not str(association.get(key, "")).strip():
            warn(CONFIG, f"params.association.{key} is empty. It is {what}. "
                         f"Only the Management Board can fill it.")


def check_security_txt():
    """Report a security.txt that has expired, or is about to.

    RFC 9116 makes Expires mandatory and says a reader should treat the file
    as stale once that date passes. Nothing else would notice: the file keeps
    serving a 200 and keeps looking correct, and the date is a year away when
    it is written, which is exactly how long it takes to forget it.
    """
    if not SECURITY_TXT.exists():
        return
    expires = None
    for line in SECURITY_TXT.read_text(encoding="utf-8").splitlines():
        if line.lower().startswith("expires:"):
            expires = line.split(":", 1)[1].strip()
            break
    if not expires:
        error(SECURITY_TXT, "no Expires field, which RFC 9116 requires")
        return
    try:
        when = datetime.datetime.fromisoformat(expires.replace("Z", "+00:00"))
    except ValueError:
        error(SECURITY_TXT, f"Expires is not a date this can read: '{expires}'")
        return
    left = (when - datetime.datetime.now(datetime.timezone.utc)).days
    if left < 0:
        error(SECURITY_TXT, f"expired {-left} days ago, on {when.date()}. "
                            "A reader treats the whole file as stale. Set a new "
                            "Expires, at most a year away.")
    elif left <= SECURITY_TXT_NOTICE_DAYS:
        warn(SECURITY_TXT, f"expires in {left} days, on {when.date()}. "
                           "Set a new Expires before it does.")


def main():
    people = collect_ids("people")
    sponsors = collect_ids("sponsors")
    check_photos(people)
    check_gallery(people)
    check_canonical_photo()
    check_logos(sponsors)
    check_social(people, sponsors)
    check_sources()
    listed_people = check_listings(people, sponsors)
    check_agenda(people)
    check_dates()
    check_channel_videos()
    check_venues()
    check_orphans(people, listed_people)
    check_security_txt()
    check_association()

    for line in warnings:
        print(f"WARNING  {line}")
    for line in errors:
        print(f"ERROR    {line}")

    talks = sum(len(ids) for ids in _talk_ids.values())
    print(f"\n{len(people)} people, {len(sponsors)} sponsors, "
          f"{talks} talks on {len(_talk_ids)} pages checked.")
    if _inventory_summary:
        print(_inventory_summary)
    if _venue_summary:
        print(_venue_summary)
    print(f"{len(errors)} errors, {len(warnings)} warnings.")
    return 1 if errors else 0


if __name__ == "__main__":
    sys.exit(main())
