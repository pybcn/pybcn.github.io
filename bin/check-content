#!/usr/bin/env python3
"""Validate the front matter in content/.

Catches the mistakes that a Hugo build does not: a person id that does not
match its filename, a duplicate id, a page that lists a person or sponsor id
with no page behind it, a declared photo with no file behind it, and a
remote photo_url. It warns about a person photo with no colour in it.

Exit code 1 if any error is found. Warnings do not fail the build.

Usage:
    bin/check-content
"""

import datetime
import pathlib
import re
import struct
import sys

import yaml

# Pillow is the library bin/square-photos needs, and pr.yml installs it for
# this check. A machine without it still runs every other check: the colour
# check reports once that it did not run, so the gap is visible and not an
# error.
try:
    from PIL import Image, ImageChops, ImageStat
except ImportError:
    Image = None

ROOT = pathlib.Path(__file__).resolve().parent.parent
CONTENT = ROOT / "content"
# Person photos moved from static/ to the theme assets so Hugo can process
# them. Accept either location, so the check works before and after that move.
LOGO_DIRS = [
    ROOT / "themes" / "pybcn_theme" / "assets" / "images" / "sponsors",
    ROOT / "assets" / "images" / "sponsors",
]
# Only the asset directories count. The template resolves a photo with
# resources.Get, which does not look in static/, so a file left there renders the
# anonymous avatar instead and the check used to pass.
PHOTO_DIRS = [
    ROOT / "themes" / "pybcn_theme" / "assets" / "images" / "people",
    ROOT / "assets" / "images" / "people",
]

FRONT_MATTER = re.compile(r"\A---\r?\n(.*?)\r?\n---[ \t]*(?:\r?\n|\Z)", re.S)

errors = []
warnings = []


def error(path, message):
    errors.append(f"{path.relative_to(ROOT)}: {message}")


def warn(path, message):
    warnings.append(f"{path.relative_to(ROOT)}: {message}")


def note(message):
    """A warning about the collection rather than about one file."""
    warnings.append(message)


_front_matter = {}


def front_matter(path):
    """Return the parsed front matter, or None if the file has none.

    The result is kept per path: several checks walk the same files, and a
    file with a YAML error should be reported once.
    """
    if path not in _front_matter:
        _front_matter[path] = _parse_front_matter(path)
    return _front_matter[path]


def _parse_front_matter(path):
    text = path.read_text(encoding="utf-8").lstrip("\ufeff")
    match = FRONT_MATTER.match(text)
    if not match:
        if text.lstrip().startswith("+++"):
            return None  # TOML front matter, not used by content/ today
        error(path, "no YAML front matter")
        return None
    try:
        return yaml.safe_load(match.group(1)) or {}
    except yaml.YAMLError as exc:
        error(path, f"front matter is not valid YAML: {exc}")
        return None


def collect_ids(section):
    """Map id -> path for every page in a section, reporting id problems."""
    found = {}
    for path in sorted((CONTENT / section).glob("*.md")):
        if path.name == "_index.md":
            continue
        data = front_matter(path)
        if data is None:
            continue
        page_id = data.get("id")
        if not page_id:
            error(path, "missing 'id'")
            continue
        if page_id != path.stem:
            error(path, f"id '{page_id}' does not match filename '{path.stem}'")
        if page_id in found:
            error(path, f"duplicate id '{page_id}', already used by {found[page_id].name}")
        found[page_id] = path
    return found


def bare_file_name(path, field, value):
    """True when the value names a file inside its directory and nothing else.

    The templates build the asset path as images/people/<photo> and
    images/sponsors/<logo_image>, and resources.Get resolves a '..' segment.
    So 'logo_image: ../people/x.jpg' showed a person's photo as a sponsor logo,
    and the existence check passed because pathlib resolves '..' the same way.
    A content-only pull request could show any image already in the repository
    on any page. A value with a separator or a '..' segment is an error.
    """
    if "/" in value or "\\" in value or ".." in value:
        error(path, f"{field} '{value}' must be a file name, not a path")
        return False
    return True


def image_size(path):
    """Return (width, height) for a PNG, GIF or JPEG, or None.

    Only the header is read, and only the three formats the people and the
    sponsor directories hold. A format this cannot read returns None and the
    caller skips the check rather than guessing.
    """
    try:
        with open(path, "rb") as handle:
            head = handle.read(32)
            if head[:8] == b"\x89PNG\r\n\x1a\n":
                return struct.unpack(">II", head[16:24])
            if head[:6] in (b"GIF87a", b"GIF89a"):
                return struct.unpack("<HH", head[6:10])
            if head[:2] == b"\xff\xd8":
                handle.seek(2)
                while True:
                    marker = handle.read(2)
                    if len(marker) < 2 or marker[0] != 0xFF:
                        return None
                    if marker[1] in range(0xC0, 0xD0) and marker[1] not in (0xC4, 0xC8, 0xCC):
                        handle.read(3)
                        height, width = struct.unpack(">HH", handle.read(4))
                        return (width, height)
                    length = struct.unpack(">H", handle.read(2))[0]
                    handle.seek(length - 2, 1)
    except (OSError, struct.error):
        return None
    return None


def check_photos(people):
    """Every person photo has to be a square the site can serve as it is.

    The square is cut once, in the repository, by bin/square-photos, so the
    build only resizes. A photo that is not square would be cropped by the
    build instead, by a rule that does not know where the face is, and nobody
    would see the result before it was live.

    The size limits are here for the pull request nobody reads closely: a
    photo straight off a phone is several megabytes and tens of megapixels,
    and it costs the repository that much for ever.
    """
    small = []
    for page_id, path in people.items():
        data = front_matter(path) or {}
        photo = data.get("photo")
        if photo and not bare_file_name(path, "photo", photo):
            continue
        found = next((d / photo for d in PHOTO_DIRS if photo and (d / photo).exists()), None)
        if photo and not found:
            where = ", ".join(str(d.relative_to(ROOT)) for d in PHOTO_DIRS)
            error(path, f"photo '{photo}' not found in any of: {where}")
            continue
        if not found:
            continue

        size = found.stat().st_size
        if size > PHOTO_MAX_BYTES:
            error(path, f"photo '{photo}' is {size // 1024} KB, over the "
                        f"{PHOTO_MAX_BYTES // 1024} KB limit. Run "
                        f"bin/square-photos, or save it smaller.")

        dimensions = image_size(found)
        if not dimensions:
            continue
        width, height = dimensions
        if width != height:
            error(path, f"photo '{photo}' is {width}x{height}, not square. "
                        f"Run bin/square-photos, which crops it on the face.")
        elif width > PHOTO_MAX_SIDE:
            error(path, f"photo '{photo}' is {width}px square, over the "
                        f"{PHOTO_MAX_SIDE}px limit. The site never serves more "
                        f"than 800. Run bin/square-photos.")
        if min(width, height) < PHOTO_SIDE:
            small.append((photo, (width, height)))

        saturation = photo_saturation(found)
        if saturation is not None and saturation < PHOTO_MIN_SATURATION:
            warn(path, f"photo '{photo}' is black and white (colour "
                       f"{saturation:.1f}, under {PHOTO_MIN_SATURATION}). It "
                       f"looks like the others on a screen that greys them on "
                       f"hover, and grey on a phone and in the modal, where "
                       f"the others are in colour. Ask for a colour photo.")
    report_small(small)
    if Image is None and people:
        note("Pillow is not installed, so the black and white photo check did "
             "not run: pip install pillow")


PHOTO_SIDE = 400
PHOTO_MAX_SIDE = 1200
PHOTO_MAX_BYTES = 1_000_000

# Mean of max(r,g,b) - min(r,g,b) per pixel, 0 to 255, over a 64px thumbnail.
# Measured on the 130 photos of October 2026, ten score 0.01 or less and the
# next one 9.5, so any value from 1 to 9 splits the two groups. 4 keeps the
# grey group clear of JPEG chroma noise, which reached 0.01, and leaves the
# muted colour photo nearest the line, at 9.5, more than twice that margin.
PHOTO_MIN_SATURATION = 4


def photo_saturation(path):
    """Return the mean colour of a photo, or None when it cannot be measured.

    The person cards grey every photo with a CSS filter on a device that can
    hover, so a photo that is already black and white looks like the others
    there. On a phone and in the modal nothing greys them, and that photo is
    the one grey face in a wall of colour. Only the person can fix it, with
    another photo, so this is a warning and never an error.

    Two of the ten grey photos are stored as greyscale; the other eight are
    RGB JPEGs with no colour in them, which no header can tell from a colour
    photo. So the pixels are read, through a 64px thumbnail: Pillow decodes a
    JPEG at a fraction of its size for that, and the 130 photos add about
    0.7 s to the run, 0.4 s to 1.1 s.
    """
    if Image is None:
        return None
    try:
        with Image.open(path) as image:
            image.thumbnail((64, 64))
            red, green, blue = image.convert("RGB").split()
    except (OSError, ValueError):
        return None
    high = ImageChops.lighter(ImageChops.lighter(red, green), blue)
    low = ImageChops.darker(ImageChops.darker(red, green), blue)
    return ImageStat.Stat(ImageChops.difference(high, low)).mean[0]


def report_small(small):
    if not small:
        return
    shown = ", ".join(f"{name} ({w}x{h})" for name, (w, h) in sorted(small)[:3])
    note(f"{len(small)} of the person photos are smaller than {PHOTO_SIDE}px on "
         f"their short side, so the build enlarges them and they look soft in "
         f"the grid. Smallest: {shown}. Replacing the file is the only fix.")


# One form per network, so a reader of the files can tell at a glance that two
# links point at the same place, and so nobody has to wonder whether
# es.linkedin.com and www.linkedin.com are the same profile. The hosts are the
# ones each service itself serves: github.com redirects www away, LinkedIn
# serves www, and twitter.com has redirected to x.com since the rename.
SOCIAL_PREFIX = {
    "github": "https://github.com/",
    "linkedin": "https://www.linkedin.com/",
    "twitter": "https://x.com/",
}

# Every field a sponsor template reads. A sponsor renders as its logo, linked
# to its site, and there is no page per sponsor, so anything else in the file
# reaches no reader. Thirty-two files carried a twitter, a linkedin, a
# mastodont or an instagram URL that has never been published: somebody wrote
# them expecting them to show, and nobody could tell they did not.
SPONSOR_FIELDS = {"id", "name", "logo_image", "site", "draft"}


def check_social(people, sponsors):
    """Check the shape of every social link in a person or sponsor file.

    Nothing else checks these. The link checker in CI reads the built pages,
    and a URL broken badly enough is not rendered as a link at all: one
    person's LinkedIn was `ttps://www.linkedin.com/...`, missing the h, which
    a browser treats as a relative path. It had never worked and nobody had
    noticed.

    A trailing slash is an error, not a warning, because the fix is mechanical
    and has one right answer. Left to taste, the values split about two to one
    between the two styles across more than two hundred links. A host has no
    trailing slash (https://ber2.github.io), so a profile path gets none either.

    A sponsor home page is in `site`, the same field as a person's. It was
    `web` until October 2026, and this loop read `site` for both kinds of page,
    so the 66 sponsor URLs were never checked: 29 ended with a slash, one was
    http and one carried a query string. The old name is an error now, so a
    sponsor file copied from an old commit cannot escape the check again.
    """
    for page_id, path in sorted({**people, **sponsors}.items()):
        data = front_matter(path) or {}
        # An empty value is the same as no field to Hugo, so it shows a
        # reader nothing. What it does is look like a checked fact: seven
        # files carried github: "" and nobody had looked for a GitHub
        # account for any of them. Fill it or take it out.
        for field, value in sorted(data.items()):
            if value is None or (isinstance(value, str) and not value.strip()):
                error(path, f"'{field}' is empty. Fill it in, or remove the "
                            f"line: an empty field is the same as no field "
                            f"to Hugo, and it reads as a fact nobody checked.")
        if page_id in sponsors:
            for field in sorted(set(data) - SPONSOR_FIELDS):
                error(path, f"'{field}' is not a sponsor field. A sponsor "
                            f"renders as its logo, linked to its site, and "
                            f"nothing else reaches a reader. Remove it, or "
                            f"render it first.")
        for field, prefix in SOCIAL_PREFIX.items():
            value = data.get(field)
            if not value:
                continue
            value = str(value).strip()
            if "?" in value:
                error(path, f"{field} carries query parameters: '{value}'. "
                            f"Copy the profile URL, not the one the browser "
                            f"was showing.")
            elif not value.startswith(prefix):
                error(path, f"{field} is '{value}', which does not start with "
                            f"{prefix}")
            elif value.endswith("/"):
                error(path, f"{field} ends with a slash: '{value}'. "
                            f"Use '{value.rstrip('/')}'.")

        if "web" in data:
            error(path, "'web' is not a field: put the home page in 'site'")

        if "short_bio" in data:
            # The field held free text about a person, next to the body that
            # held the same kind of text. For 98 of 136 people only one of
            # the two was filled, so the modal showed a "Bio" heading for
            # some people and a "Description" heading for others. In October
            # 2026 every value moved into the body and the template reads
            # only the body now, so a value here is never shown. An error,
            # because the one way the field comes back is a file copied from
            # an old commit, and then the text is lost in silence.
            error(path, "'short_bio' is not a field: put the text in the body "
                        "of the file, under the front matter")

        site = data.get("site")
        if site:
            site = str(site).strip()
            if "?" in site:
                # A warning here, an error on the three profile fields. A
                # profile URL never needs a query, so one is always the
                # tracking the browser added. A site is any address, and the
                # query can be the address: a sponsor links to
                # empleos-barcelona?q=python, and without the query the link
                # lands on every job in Barcelona rather than the Python ones.
                warn(path, f"site carries query parameters: '{site}'. "
                              f"Keep them only if they are part of the "
                              f"address, not tracking the browser added.")
            elif not site.startswith(("https://", "http://")):
                error(path, f"site is '{site}', which is not an http or https URL")
            else:
                if site.endswith("/"):
                    error(path, f"site ends with a slash: '{site}'. "
                                f"Use '{site.rstrip('/')}'.")
                if site.startswith("http://"):
                    # An error, not a warning. A link we publish over http is
                    # one we invite a reader to follow in the clear, and the
                    # site it points at is not ours to make safe. If https
                    # does not answer, that is for its owner to fix, and the
                    # link stays broken rather than insecure.
                    error(path, f"site is served over http, not https: "
                                f"'{site}'. Use https, and if the site does "
                                f"not answer over https, that is for its "
                                f"owner to fix.")


# The largest size the build asks of a source, by directory, and the weight
# that makes an oversized one worth rewriting. Both tables are the ones
# bin/fit-sources works from, and its docstring says which template sets each
# cap. Keep the two in step: this check is what points at that script.
SOURCE_CAPS = {
    "sponsors": (1120, 300),
    "photos": (1600, None),
    "logo.png": (920, None),
}
SOURCE_MIN_KB = 150
SOURCE_MAX_MPX = 4


def source_cap(relative):
    """Return the cap that covers this path under assets/images, or None."""
    for key, cap in SOURCE_CAPS.items():
        if relative.as_posix() == key or relative.parts[0] == key:
            return cap
    return None


def check_sources():
    """A source far larger than anything the site serves is weight and risk.

    Hugo makes every file a reader gets, so a source only has to be as large
    as the biggest variant a template asks for. orpheus.png reached
    23944x5753, which is 138 megapixels and about 551 MB of RAM to decode, for
    a logo the page shows at 560x135. Every build paid that, and so did every
    tool that opened the repository.

    Being over the cap is not enough on its own: a 512x512 logo shown at
    300x300 costs almost nothing, and rewriting it would throw away the only
    copy there is. The file has to be heavy as well, on disk or to decode.
    """
    # The images directory above people/ and sponsors/, which is where the
    # caps are keyed from: both lists name a directory inside it.
    images = {d.parent for d in PHOTO_DIRS + LOGO_DIRS}
    for base in sorted(images):
        if not base.is_dir():
            continue
        for path in sorted(base.rglob("*")):
            if not path.is_file() or path.suffix.lower() not in SOURCE_SUFFIXES:
                continue
            relative = path.relative_to(base)
            cap = source_cap(relative)
            if cap is None:
                continue
            dimensions = image_size(path)
            if not dimensions:
                continue
            width, height = dimensions
            max_width, max_height = cap
            over = width > max_width or (max_height and height > max_height)
            if not over:
                continue
            size = path.stat().st_size
            megapixels = width * height / 1e6
            if size / 1024 <= SOURCE_MIN_KB and megapixels <= SOURCE_MAX_MPX:
                continue
            fits = f"{max_width}x{max_height}" if max_height else f"{max_width} wide"
            error(path, f"is {width}x{height} ({megapixels:.1f} Mpx, "
                        f"{size // 1024} KB), over the {fits} the build asks "
                        f"of it. Run bin/fit-sources.")


SOURCE_SUFFIXES = {".jpg", ".jpeg", ".png", ".webp"}


def check_logos(sponsors):
    """A sponsor whose declared logo file is missing renders a broken image, and
    the Hugo build does not notice. A sponsor with no logo_image at all is only
    a warning, because the template falls back to the name as text.

    The logo field, an external URL, is an error: the template no longer reads
    it, because it accepted any scheme and any host and so let a pull request
    load a third-party image on every page that lists the sponsor."""
    for page_id, path in sponsors.items():
        data = front_matter(path) or {}
        if "logo" in data:
            error(path, f"'logo' is not supported: copy the file under "
                        f"{LOGO_DIRS[0].relative_to(ROOT)} and use logo_image")
        logo = data.get("logo_image")
        if not logo:
            warn(path, f"sponsor '{page_id}' declares no logo, so it renders as text")
            continue
        if not bare_file_name(path, "logo_image", logo):
            continue
        if not any((d / logo).exists() for d in LOGO_DIRS):
            where = ", ".join(str(d.relative_to(ROOT)) for d in LOGO_DIRS)
            error(path, f"logo '{logo}' not found in any of: {where}")


# The front matter keys the templates read to list people or sponsors by id,
# mapped to the name of the id list inside each level. event.html reads
# people_sections and sponsor_levels, people.html reads people_levels and
# sponsors.html reads sponsor_levels.
LISTING_KEYS = {
    "people_sections": "people",
    "people_levels": "people",
    "sponsor_levels": "sponsors",
}


# The keys an entry of a people list may carry when it is a map rather than
# a bare id. people-grid.html reads both; anything else is a misspelling the
# template would drop in silence.
ENTRY_KEYS = {"id", "role"}


def entry_id(path, key, entry):
    """Return the id of one entry of a listing, or None if it has none.

    A people entry is a bare id, or a map with an id and a role that the page
    shows instead of the person's pybcn_position (see people-grid.html). The
    check used to compare the entry itself against the known ids, which
    raised a TypeError on a map.
    """
    if isinstance(entry, str):
        return entry
    if not isinstance(entry, dict):
        error(path, f"'{key}' lists {entry!r}, which is not an id")
        return None
    if key != "people_levels" and key != "people_sections":
        error(path, f"'{key}' lists {entry!r}, but only a people list may hold a map")
        return None
    unknown = set(entry) - ENTRY_KEYS
    if unknown:
        error(path, f"'{key}' entry {entry!r} has unknown key(s) "
                    f"{', '.join(sorted(unknown))}; allowed: id, role")
    if not entry.get("id"):
        error(path, f"'{key}' entry {entry!r} has no id")
        return None
    return entry["id"]


def referenced_ids(path, data, key):
    """Pull every id out of one listing key of a page.

    people_levels and sponsor_levels hold a list of levels. people_sections
    holds a list of sections, each with its own list of levels.
    """
    out = []
    for section in data.get(key) or []:
        if not isinstance(section, dict):
            error(path, f"'{key}' holds {section!r}, which is not a level")
            continue
        for level in section.get("levels") or [section]:
            if not isinstance(level, dict):
                error(path, f"'{key}' holds {level!r}, which is not a level")
                continue
            for entry in level.get(LISTING_KEYS[key]) or []:
                ref = entry_id(path, key, entry)
                if ref is not None:
                    out.append(ref)
    return out


def check_listings(people, sponsors):
    """Every page that lists people or sponsors by id must point at pages that exist.

    The template drops an unknown id without a word, so the page just shows one
    sponsor or one person less. The check walks every file under content/ and
    looks for the keys the templates read, instead of a fixed set of
    directories or page names. The old events walk covered content/events/
    only, so a typo in content/sponsors/_index.md or in
    content/pyladies_bcn/sponsors.md was never reported, and the organizers
    pages were listed by name, so a rename switched that check off in silence.

    Returns the set of person ids that some page lists, for the orphan check.
    """
    listed_people = set()
    for path in sorted(CONTENT.rglob("*.md")):
        data = front_matter(path)
        if data is None:
            continue
        for key, kind in LISTING_KEYS.items():
            if key not in data:
                continue
            known = people if kind == "people" else sponsors
            noun = "person" if kind == "people" else "sponsor"
            for ref in referenced_ids(path, data, key):
                if ref not in known:
                    error(path, f"'{key}' references unknown {noun} id '{ref}'")
                elif kind == "people":
                    listed_people.add(ref)
    return listed_people


# The colour classes agenda.scss defines for an entry of the schedule. The
# entry's color value lands in the class attribute as it is, so a missing or
# misspelt value gets the fallback background instead of a brand colour.
AGENDA_COLOURS = {"blue", "green", "grey", "orange", "pink", "purple", "red", "yellow"}


def check_agenda():
    """Every entry of a schedule must carry one of the agenda colour classes."""
    for path in sorted(CONTENT.rglob("*.md")):
        data = front_matter(path)
        if data is None or not data.get("events"):
            continue
        for entry in data["events"]:
            if not isinstance(entry, dict):
                error(path, f"'events' holds {entry!r}, which is not an entry")
                continue
            colour = entry.get("color")
            title = entry.get("title") or entry.get("speaker") or "?"
            if not colour:
                error(path, f"agenda entry '{title}' has no color; use one of: "
                            f"{', '.join(sorted(AGENDA_COLOURS))}")
            elif colour not in AGENDA_COLOURS:
                error(path, f"agenda entry '{title}' has color '{colour}', which is "
                            f"not one of: {', '.join(sorted(AGENDA_COLOURS))}")


def check_orphans(people, listed_people):
    """A person page no listing points at renders, but nobody can reach it.

    The check compares against the ids check_listings collected from the
    front matter keys, so only a real listing counts. The old check searched
    the text of every page with a word-boundary regex, and a regex boundary
    sits between a letter and a hyphen: 'ricardo' matched inside
    'ricardo-ander-egg' and 'jordi' inside 'jordi-bosch', so those two pages
    passed with no listing at all. Prose that happens to contain an id does
    not count as a reference either.
    """
    for page_id, path in people.items():
        if page_id not in listed_people:
            warn(path, f"person '{page_id}' is not listed by any event or page")


SECURITY_TXT = ROOT / "static" / ".well-known" / "security.txt"
SECURITY_TXT_NOTICE_DAYS = 30


def check_security_txt():
    """Report a security.txt that has expired, or is about to.

    RFC 9116 makes Expires mandatory and says a reader should treat the file
    as stale once that date passes. Nothing else would notice: the file keeps
    serving a 200 and keeps looking correct, and the date is a year away when
    it is written, which is exactly how long it takes to forget it.
    """
    if not SECURITY_TXT.exists():
        return
    expires = None
    for line in SECURITY_TXT.read_text(encoding="utf-8").splitlines():
        if line.lower().startswith("expires:"):
            expires = line.split(":", 1)[1].strip()
            break
    if not expires:
        error(SECURITY_TXT, "no Expires field, which RFC 9116 requires")
        return
    try:
        when = datetime.datetime.fromisoformat(expires.replace("Z", "+00:00"))
    except ValueError:
        error(SECURITY_TXT, f"Expires is not a date this can read: '{expires}'")
        return
    left = (when - datetime.datetime.now(datetime.timezone.utc)).days
    if left < 0:
        error(SECURITY_TXT, f"expired {-left} days ago, on {when.date()}. "
                            "A reader treats the whole file as stale. Set a new "
                            "Expires, at most a year away.")
    elif left <= SECURITY_TXT_NOTICE_DAYS:
        warn(SECURITY_TXT, f"expires in {left} days, on {when.date()}. "
                           "Set a new Expires before it does.")


def main():
    people = collect_ids("people")
    sponsors = collect_ids("sponsors")
    check_photos(people)
    check_logos(sponsors)
    check_social(people, sponsors)
    check_sources()
    listed_people = check_listings(people, sponsors)
    check_agenda()
    check_orphans(people, listed_people)
    check_security_txt()

    for line in warnings:
        print(f"WARNING  {line}")
    for line in errors:
        print(f"ERROR    {line}")

    print(f"\n{len(people)} people, {len(sponsors)} sponsors checked.")
    print(f"{len(errors)} errors, {len(warnings)} warnings.")
    return 1 if errors else 0


if __name__ == "__main__":
    sys.exit(main())
