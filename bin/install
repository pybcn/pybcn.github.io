#!/bin/bash
#
# Install the pinned Hugo extended binary into bin/hugo.
#
# The version comes from .hugo-version, which is the single source of truth.
# bin/hugo is ignored by git.

set -euo pipefail

ROOT=$(cd "$(dirname "$0")/.." && pwd -P)
. ${ROOT}/bin/helpers

RELEASES="https://github.com/gohugoio/hugo/releases/download"

function platform() {
  local os arch
  case "$(uname -s)" in
    Linux)  os="linux" ;;
    Darwin) os="darwin" ;;
    *) echo "Unsupported OS: $(uname -s)." >&2
       echo "Download Hugo ${HUGO_VERSION} extended yourself and put it at bin/hugo." >&2
       exit 1 ;;
  esac
  case "$(uname -m)" in
    x86_64|amd64)  arch="amd64" ;;
    arm64|aarch64) arch="arm64" ;;
    *) echo "Unsupported architecture: $(uname -m)." >&2
       exit 1 ;;
  esac
  # Hugo ships a single universal darwin build.
  if [ "${os}" = "darwin" ]; then
    echo "darwin-universal"
  else
    echo "${os}-${arch}"
  fi
}

function install_hugo() {
  local target archive url checksums workdir
  target=$(platform)
  archive="hugo_extended_${HUGO_VERSION}_${target}.tar.gz"
  url="${RELEASES}/v${HUGO_VERSION}/${archive}"
  checksums="hugo_${HUGO_VERSION}_checksums.txt"

  workdir=$(mktemp -d)
  trap 'rm -rf "${workdir}"' RETURN

  echo "Downloading Hugo ${HUGO_VERSION} extended (${target})..."
  curl -sSfL -o "${workdir}/${archive}" "${url}"
  curl -sSfL -o "${workdir}/${checksums}" "${RELEASES}/v${HUGO_VERSION}/${checksums}"

  echo -n "Verifying checksum... "
  (cd "${workdir}" && grep " ${archive}\$" "${checksums}" | sha256sum -c - >/dev/null)
  echo "OK"

  tar xzf "${workdir}/${archive}" -C "${workdir}" hugo
  mv "${workdir}/hugo" "${ROOT}/bin/hugo"
  chmod +x "${ROOT}/bin/hugo"
}

if eval_right_hugo; then
  echo "Hugo ${HUGO_VERSION} extended is already installed."
  exit 0
fi

install_hugo
eval_right_hugo
